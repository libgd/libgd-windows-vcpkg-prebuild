{
  "vcpkgExecutable": "C:\\vcpkg\\vcpkg.exe",
  "archives": [
    {
      "archiveName": "x64-windows.7z",
      "triplet": "x64-windows",
      "packages": [
        "brotli",
        "bzip2",
        "freetype",
        "libde265",
        "libheif",
        "libjpeg-turbo",
        "libjxl",
        "liblzma",
        "libpng",
        "libyuv",
        "libwebp",
        "tiff",
        "x265",
        "zlib",
        "libiconv",
        "freetype",
        "exiv2",
        "aom",
        "dav1d"
      ],
      "customBuilds": [
        {
          "name": "libavif",
          "sourceUrl": "https://github.com/AOMediaCodec/libavif/archive/refs/tags/v1.4.2.zip",
          "buildType": "Release",
          "cmakeOptions": [
            "AVIF_CODEC_AOM=SYSTEM",
            "AVIF_CODEC_DAV1D=SYSTEM",
            "BUILD_SHARED_LIBS=ON",
            "AVIF_BUILD_APPS=OFF",
            "AVIF_BUILD_TESTS=OFF"
          ],
          "requiredFiles": [
            "include/avif/avif.h",
            "lib/avif.lib",
            "lib/cmake/libavif/libavif-config.cmake"
          ],
          "copyDirectories": [
            {
              "source": "lib/cmake/libavif",
              "destination": "share/libavif"
            }
          ]
        },
        {
          "name": "libultrahdr",
          "sourceUrl": "https://github.com/google/libultrahdr/archive/refs/tags/v1.4.0.zip",
          "buildType": "Release",
          "cmakeOptions": [
            "BUILD_SHARED_LIBS=ON",
            "UHDR_BUILD_EXAMPLES=OFF",
            "UHDR_BUILD_TESTS=OFF",
            "UHDR_BUILD_BENCHMARK=OFF",
            "UHDR_BUILD_FUZZERS=OFF",
            "UHDR_BUILD_DEPS=OFF",
            "UHDR_BUILD_JAVA=OFF",
            "UHDR_BUILD_PACKAGING=OFF",
            "UHDR_ENABLE_GLES=OFF",
            "UHDR_ENABLE_WERROR=OFF",
            "UHDR_WRITE_XMP=OFF"
          ],
          "copyFiles": [
            {
              "from": "source",
              "source": "ultrahdr_api.h",
              "destination": "include/ultrahdr_api.h"
            },
            {
              "source": "uhdr.dll",
              "destination": "bin/uhdr.dll"
            },
            {
              "source": "uhdr.lib",
              "destination": "lib/uhdr.lib"
            },
            {
              "source": "uhdr-static.lib",
              "destination": "lib/uhdr-static.lib"
            }
          ],
          "requiredFiles": [
            "include/ultrahdr_api.h",
            "bin/uhdr.dll",
            "lib/uhdr.lib",
            "lib/uhdr-static.lib"
          ]
        }
      ]
    },
